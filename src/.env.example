# Grid Guardian backend configuration
# Copy this file to .env and adjust as needed. All values have safe defaults.

# Display name used in API docs and the MCP server identity
APP_NAME="Grid Guardian - Outage Prediction & Equipment Failure Advisor"

# Port the FastAPI server binds to
API_PORT=8000

# Risk engine weighting - must sum to 1.0
WEIGHT_SENSOR_HEALTH=0.5
WEIGHT_WEATHER_RISK=0.3
WEIGHT_HISTORICAL_RISK=0.2
